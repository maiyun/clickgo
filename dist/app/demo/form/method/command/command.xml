<form title="MCP demo" width="460" height="330" min-width="300" min-height="240" direction="v" padding="12">
    <!-- 当前窗口的三个公开命令共享同一计数器 -->
    <layout style="flex: 1; min-height: 0;">
        <flow v-model:scroll-top="scrollTop" direction="v" @clientheight="clientHeight = $event" @scrollheight="scrollHeight = $event" style="flex: 1; min-width: 0;">
            <layout direction="v" gutter="12" style="padding: 4px;">
                <group title="Counter" direction="v" gutter="8">
                    <label size="xl">{{value}}</label>
                    <label>{{lastAction ? 'Last command: ' + lastAction : 'Waiting for the first command.'}}</label>
                </group>
                <!-- 复制的指令携带实例标识，多个 Demo 窗口可同时验证 -->
                <layout direction="v" gutter="8">
                    <label>Your agent can read this counter, increase it or export its value as a text file.</label>
                    <label copy>Ask your agent: “Read the counter, increase it by one and report the new value.”</label>
                    <layout><button type="cg" @click="copyPrompt">Copy test prompt</button></layout>
                    <text v-if="showPrompt" :model-value="testPrompt" readonly type="multi" dir="ltr" style="height: 66px;"></text>
                </layout>
            </layout>
        </flow>
        <scroll v-if="scrollHeight > clientHeight" v-model:offset="scrollTop" :length="scrollHeight" :client="clientHeight"></scroll>
    </layout>
    <!-- 两种通用工具由框架创建，缩小窗口时入口仍可见 -->
    <layout gutter="8" wrap style="padding: 10px 4px 4px;">
        <button @click="guide">AI access guide</button>
        <button @click="palette">Command palette</button>
    </layout>
</form>
