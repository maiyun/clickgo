<form width="350" height="560" title="Library theme" padding="10">
    <flow direction="v" gutter="10" style="flex: 1;">
        <button @click="load">Load "/clickgo/theme/dark.cgt"</button>
        <button @click="remove">remove('dark')</button>
        <button @click="clear">clear()</button>
        <button @click="setGlobal('light')">setGlobal "/clickgo/theme/light.cgt"</button>
        <button @click="setGlobal('dark')">setGlobal "/clickgo/theme/dark.cgt"</button>
        <button @click="setGlobal('software-dark')">setGlobal "/clickgo/theme/software-dark.cgt"</button>
        <button @click="setGlobal('software-light')">setGlobal "/clickgo/theme/software-light.cgt"</button>
        <button @click="setGlobal('classic-light')">setGlobal "/clickgo/theme/classic-light.cgt"</button>
        <button @click="setGlobal('cyber-dark')">setGlobal "/clickgo/theme/cyber-dark.cgt"</button>
        <button @click="setGlobal('dashboard-light')">setGlobal "/clickgo/theme/dashboard-light.cgt"</button>
        <button @click="setGlobal('cloud-light')">setGlobal "/clickgo/theme/cloud-light.cgt"</button>
        <button @click="setGlobal('cloud-dark')">setGlobal "/clickgo/theme/cloud-dark.cgt"</button>
        <button @click="setGlobal('admin-light')">setGlobal "/clickgo/theme/admin-light.cgt"</button>
        <button @click="setGlobal('modern-dark')">setGlobal "/clickgo/theme/modern-dark.cgt"</button>
        <button @click="setGlobal('modern-light')">setGlobal "/clickgo/theme/modern-light.cgt"</button>
        <button @click="setGlobalFromFile('/clickgo/theme/dark')">setGlobalFromFile("/clickgo/theme/dark")</button>
        <button @click="clearGlobal">clearGlobal()</button>
        <button @click="setMain('oklch(.65 .23 28)')" type="cg">setMain('oklch(.65 .23 28)')</button>
        <button @click="setMain()" type="cg">setMain()</button>
    </flow>
</form>
