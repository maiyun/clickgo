<flow class="options" direction="v" gutter="10">
    <layout align-v="center" gutter="8">
        <label style="flex: 1">Brush options</label>
        <button @click="emit('select')">Use brush</button>
    </layout>
    <label>Mounted at {{mountedAt}}</label>
    <layout align-v="center" gutter="8">
        <label>Size</label>
        <number v-model="sizeData" min="1" max="80" style="flex: 1"></number>
    </layout>
    <layout align-v="center" gutter="8">
        <label>Opacity</label>
        <number v-model="opacityData" min="0.05" max="1" style="flex: 1"></number>
    </layout>
    <palette v-model="colorData"></palette>
</flow>
