<flow class="options" direction="v" gutter="10">
    <layout align-v="center" gutter="8">
        <label style="flex: 1">Pencil options</label>
        <button @click="emit('select')">Use pencil</button>
    </layout>
    <label>Mounted at {{mountedAt}}</label>
    <layout align-v="center" gutter="8">
        <label>Size</label>
        <slider v-model="sizeSliderData" min="1" max="20" show-value label="Pencil size" style="flex: 1"></slider>
    </layout>
    <layout align-v="center" gutter="8">
        <label>Opacity</label>
        <slider v-model="opacitySliderData" min="0.05" max="1" step="0.05" show-value label="Pencil opacity" style="flex: 1"></slider>
    </layout>
    <palette v-model="colorData"></palette>
</flow>
